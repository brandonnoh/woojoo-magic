# ─────────────────────────────────────────────────────────────
# {서비스명} robots.txt — AEO 정책
# 원칙: 학습(train)은 정책에 따라, 검색(search)·사용자개시(user)는 허용.
#       검색계를 막으면 AI 답변 인용이 사라진다.
# ─────────────────────────────────────────────────────────────

# ── 검색·인용 계열: 허용 (AEO의 생명줄) ──
User-agent: OAI-SearchBot
User-agent: PerplexityBot
User-agent: Claude-SearchBot
Allow: /
Content-Signal: search=yes, ai-input=yes

# ── 사용자 개시: 허용 ──
User-agent: ChatGPT-User
User-agent: Perplexity-User
User-agent: Claude-User
Allow: /
Content-Signal: search=yes, ai-input=yes

# ── 학습 계열: 아래는 "학습 거부" 예시. 브랜드 노출이 목표면 Allow로 바꾼다 ──
User-agent: GPTBot
User-agent: ClaudeBot
User-agent: anthropic-ai
User-agent: Claude-Web
User-agent: Google-Extended
User-agent: Applebot-Extended
User-agent: meta-externalagent
User-agent: Amazonbot
User-agent: Bytespider
User-agent: CCBot
User-agent: cohere-ai
Disallow: /
Content-Signal: ai-train=no, search=yes, ai-input=yes

# ── 기본 ──
User-agent: *
Allow: /
Disallow: /api/
Disallow: /admin/
Content-Signal: search=yes, ai-input=yes, ai-train=no

Sitemap: https://example.com/sitemap.xml
# ARD 매니페스트를 게시했다면:
# Agentmap: https://example.com/.well-known/ai-catalog.json

# 주의: Content-Signal은 선언이지 강제가 아니다(Google 미사용 공식 확인).
#       실제 차단은 WAF / Bot Management / AI Crawl Control이 한다.
