{
  "_path": "/.well-known/api-catalog  (Content-Type: application/linkset+json)",
  "_spec": "RFC 9727",
  "linkset": [
    {
      "anchor": "https://example.com/api/v1",
      "service-desc": [
        { "href": "https://example.com/openapi.json", "type": "application/json" }
      ],
      "service-doc": [
        { "href": "https://example.com/docs/api", "type": "text/html" }
      ],
      "status": [
        { "href": "https://status.example.com/api.json", "type": "application/json" }
      ]
    }
  ]
}
